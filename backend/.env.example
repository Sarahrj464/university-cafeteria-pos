PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Supabase or local)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/cafeteria_pos

# JWT secrets — use long random strings in production (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://your-app.vercel.app

